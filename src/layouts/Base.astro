---
import '../styles/global.css';
// Built asset (inlined or hashed), so a new logo shows at once. Browsers keep public/ files for 4 hours.
import logo from '../assets/logo.svg?url';
import { getReleases, formatDay, firstLine } from '../lib/releases';

interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title: string; description: string };
}

// Markdown pages (privacy.md) pass their frontmatter; .astro pages pass props.
const fm = Astro.props.frontmatter;
const { title, description } = fm ?? Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const download = 'https://github.com/aipdv/better-files/releases/latest';

// Footer shows the 5 newest releases. The daily deploy run keeps the list fresh.
// If GitHub fails, the footer shows only "All releases" and the build goes on.
const releases = (await getReleases()).slice(0, 5);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#F5F5F7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://bf.aipdv.com/og.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://bf.aipdv.com/og.png" />
    <!-- "js": GSAP will run. "full": the visitor allows self-running motion. Undo both after 2.5 s if GSAP never loads. -->
    <script is:inline>(()=>{const r=document.documentElement;r.classList.add('js');if(matchMedia('(prefers-reduced-motion: no-preference)').matches)r.classList.add('full');setTimeout(()=>{if(!r.classList.contains('motion-ready')){r.classList.remove('js','full');document.querySelectorAll('video').forEach(v=>v.controls=true)}},2500)})()</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="edge" aria-hidden="true"></div>
    <nav class="nav" aria-label="Main">
      <a class="brand" href="/" aria-label="Better Files home"><img src={logo} alt="" width="34" height="34" />Better Files</a>
      <a class="nl" href="/#features">Features</a>
      <a class="nl" href="/privacy/">Privacy</a>
      <a class="nl" href="/changelog/">Changelog</a>
      <a class="nl" href="https://github.com/aipdv/better-files">GitHub</a>
      <span class="sp"></span>
      <a class="btn p sm" href={download}><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224,144v64a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V144a8,8,0,0,1,16,0v56H208V144a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,124.69V32a8,8,0,0,0-16,0v92.69L93.66,98.34a8,8,0,0,0-11.32,11.32Z"/></svg>Download</a>
    </nav>

    <div id="smooth-wrapper"><div id="smooth-content">
    <main id="main">
      {fm ? <article class="prose"><slot /></article> : <slot />}
    </main>

    <footer class="foot">
      <div class="foot-in">
        <div>
          <a class="brand" href="/"><img src={logo} alt="" width="28" height="28" />Better Files</a>
          <p>Free and open source under GPL-3.0.<br />Built on <a href="https://github.com/zhanghai/MaterialFiles">Material Files</a>.</p>
          <p>"Better Files" and the Better Files logo are trademarks of aipdv.</p>
        </div>
        <nav aria-label="Footer">
          <h2>Site</h2>
          <ul class="nav-l">
            <li><a href={download}>Download</a></li>
            <li><a href="/changelog/">Changelog</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="https://github.com/aipdv/better-files">GitHub</a></li>
          </ul>
        </nav>
        <div>
          <h2>Latest releases</h2>
          <ul class="rel">{releases.map((r) => <li><a href={r.html_url}>{r.tag_name}</a><time datetime={r.published_at}>{formatDay(r.published_at)}</time><span>{firstLine(r.body)}</span></li>)}</ul>
          <a class="all" href="/changelog/">Full changelog</a>
        </div>
      </div>
    </footer>
    </div></div>

    <!-- Cloudflare Web Analytics: no cookies. -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "dcb9b799222e4caf9691b680f89f83a9"}'></script>
  </body>
</html>
