---
import '../styles/global.css';
// Built asset (inlined or hashed), so a new logo shows at once. Browsers keep public/ files for 4 hours.
import logo from '../assets/logo.svg?url';

interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title: string; description: string };
}

// Markdown pages (privacy.md) pass their frontmatter; .astro pages pass props.
const fm = Astro.props.frontmatter;
const { title, description } = fm ?? Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const download = 'https://github.com/aipdv/better-files/releases/latest';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#F5F5F7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://bf.aipdv.com/og.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://bf.aipdv.com/og.png" />
    <!-- "js": GSAP will run. "full": the visitor allows self-running motion. Undo both after 2.5 s if GSAP never loads. -->
    <script is:inline>(()=>{const r=document.documentElement;r.classList.add('js');if(matchMedia('(prefers-reduced-motion: no-preference)').matches)r.classList.add('full');setTimeout(()=>{if(!r.classList.contains('motion-ready')){r.classList.remove('js','full');document.querySelectorAll('video').forEach(v=>v.controls=true)}},2500)})()</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="edge" aria-hidden="true"></div>
    <nav class="nav" aria-label="Main">
      <a class="brand" href="/" aria-label="Better Files home"><img src={logo} alt="" width="34" height="34" />Better Files</a>
      <a class="nl" href="/#features">Features</a>
      <a class="nl" href="/privacy/">Privacy</a>
      <a class="nl" href="/changelog/">Changelog</a>
      <a class="nl" href="https://github.com/aipdv/better-files">GitHub</a>
      <span class="sp"></span>
      <a class="btn p sm" href={download}><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224,144v64a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V144a8,8,0,0,1,16,0v56H208V144a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,124.69V32a8,8,0,0,0-16,0v92.69L93.66,98.34a8,8,0,0,0-11.32,11.32Z"/></svg>Download</a>
    </nav>

    <div id="smooth-wrapper"><div id="smooth-content">
    <main id="main">
      {fm ? <article class="prose"><slot /></article> : <slot />}
    </main>

    <!-- Every page ends on one dark panel: the call to action, then the site links. -->
    <footer class="foot">
      <h2>Install it and search by <em class="acc">what you remember.</em></h2>
      <div class="cta">
        <a class="btn p" href={download}><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224,144v64a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V144a8,8,0,0,1,16,0v56H208V144a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,124.69V32a8,8,0,0,0-16,0v92.69L93.66,98.34a8,8,0,0,0-11.32,11.32Z"/></svg>Download APK</a>
        <a class="btn v" href="https://github.com/aipdv/better-files"><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M208.31,75.68A59.78,59.78,0,0,0,202.93,28,8,8,0,0,0,196,24a59.75,59.75,0,0,0-48,24H124A59.75,59.75,0,0,0,76,24a8,8,0,0,0-6.93,4,59.78,59.78,0,0,0-5.38,47.68A58.14,58.14,0,0,0,56,104v8a56.06,56.06,0,0,0,48.44,55.47A39.8,39.8,0,0,0,96,192v8H72a24,24,0,0,1-24-24A40,40,0,0,0,8,136a8,8,0,0,0,0,16,24,24,0,0,1,24,24,40,40,0,0,0,40,40H96v16a8,8,0,0,0,16,0V192a24,24,0,0,1,48,0v40a8,8,0,0,0,16,0V192a39.8,39.8,0,0,0-8.44-24.53A56.06,56.06,0,0,0,216,112v-8A58.14,58.14,0,0,0,208.31,75.68ZM200,112a40,40,0,0,1-40,40H112a40,40,0,0,1-40-40v-8a41.74,41.74,0,0,1,6.9-22.48A8,8,0,0,0,80,73.83a43.81,43.81,0,0,1,.79-33.58,43.88,43.88,0,0,1,32.32,20.06A8,8,0,0,0,119.82,64h32.35a8,8,0,0,0,6.74-3.69,43.87,43.87,0,0,1,32.32-20.06A43.81,43.81,0,0,1,192,73.83a8.09,8.09,0,0,0,1,7.65A41.72,41.72,0,0,1,200,104Z"/></svg>Source on GitHub</a>
      </div>
      <div class="foot-row">
        <a class="brand" href="/"><img src={logo} alt="" width="24" height="24" />Better Files</a>
        <nav aria-label="Footer"><a href={download}>Download</a><a href="/changelog/">Changelog</a><a href="/privacy/">Privacy</a><a href="https://github.com/aipdv/better-files">GitHub</a></nav>
      </div>
      <div class="legal">
        <p>Free and open source under GPL-3.0. Built on <a href="https://github.com/zhanghai/MaterialFiles">Material Files</a>.</p>
        <p>"Better Files" and the Better Files logo are trademarks of aipdv.</p>
      </div>
    </footer>
    </div></div>

    <!-- Cloudflare Web Analytics: no cookies. -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "dcb9b799222e4caf9691b680f89f83a9"}'></script>
  </body>
</html>
