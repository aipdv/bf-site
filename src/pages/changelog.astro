---
import Base from '../layouts/Base.astro';
import { getReleases, formatDay, firstLine, sections } from '../lib/releases';

// Built at deploy time from the GitHub releases, newest first.
const releases = await getReleases();
const download = 'https://github.com/aipdv/better-files/releases/latest';
---
<Base
  title="Changelog: Better Files"
  description="Every Better Files release, newest first, with the notes from GitHub."
>
  <div class="page">
    <p class="eyebrow"><i></i>Changelog</p>
    <h1>What’s new in <em>Better Files.</em></h1>
    <p class="lead">Every release, newest first. Notes come from GitHub.</p>

    {releases.length === 0 ? (
      <div class="older">
        <p>Release notes are not available right now.</p>
        <p><a href="https://github.com/aipdv/better-files/releases">All releases on GitHub</a></p>
      </div>
    ) : (
      <section class="tl" aria-label="Releases">
        {releases.map((r, i) => {
          const secs = sections(r.body);
          const bullets = secs.filter((s) => /what/i.test(s.title)).flatMap((s) => s.items);
          const limits = secs.find((s) => /known limits/i.test(s.title))?.items ?? [];
          const apk = r.assets.find((a) => a.name.endsWith('.apk'))?.browser_download_url ?? r.html_url;
          return (
            <article class={i === 0 ? 'entry first' : 'entry'}>
              <header class="when">
                <span class="ver">{r.tag_name}</span>
                <span class="node" aria-hidden="true"></span>
                <span class="date">{formatDay(r.published_at)}</span>
              </header>
              <div class="card">
                <div class="badges">
                  {r.prerelease && <span class="badge">Beta</span>}
                  {i === 0 && <span class="badge g">Latest</span>}
                </div>
                <h2>{firstLine(r.body) || r.tag_name}</h2>

                <div class="video">
                  <div class="ph"><span class="play" aria-hidden="true"></span><b>Video coming soon</b></div>
                </div>

                {bullets.length > 0 && (
                  <ul>
                    {bullets.map((b) => <li>{b}</li>)}
                  </ul>
                )}

                {limits.length > 0 && (
                  <details>
                    <summary>Known limits</summary>
                    <ul>
                      {limits.map((l) => <li>{l}</li>)}
                    </ul>
                  </details>
                )}

                <div class="actions">
                  <a class="btn p sm" href={apk}>Download APK</a>
                  <a class="btn v sm" href={r.html_url}>Release notes on GitHub</a>
                </div>
              </div>
            </article>
          );
        })}
      </section>
    )}

    <div class="older">
      <strong>Older releases</strong> are on <a href="https://github.com/aipdv/better-files/releases">GitHub</a>.
    </div>
  </div>
</Base>

<style>
  .page { --gutter: clamp(24px, 14vw, 220px); width: min(720px, calc(100% - 2 * var(--gutter))); margin: 0 auto; padding: 128px 0 0; text-align: center; }
  .page h1 { font-size: clamp(38px, 5.4vw, 56px); letter-spacing: -0.035em; line-height: 1.02; margin: 0 0 12px; }
  .page h1 em { font-family: var(--serif); font-style: italic; font-weight: 500; color: var(--blue); letter-spacing: -0.02em; }
  .page .eyebrow { margin-top: 0; }
  .lead { color: var(--muted); margin: 0 auto; max-width: 520px; }

  /* One rail for the list, from the first node down to the last entry. */
  .tl { position: relative; margin-top: 56px; }
  .tl::before { content: ""; position: absolute; left: 50%; top: 11px; bottom: 0; width: 1px; background: var(--line); transform: translateX(-50%); }
  .entry { padding-bottom: 64px; }
  .entry:last-child { padding-bottom: 0; }

  /* Header row: version | node | date. */
  .when { display: grid; grid-template-columns: 1fr auto 1fr; column-gap: 12px; align-items: center; height: 22px; margin-bottom: 18px; }
  .ver { justify-self: end; font: 600 14px/1 ui-monospace, Menlo, monospace; color: var(--ink); }
  .date { justify-self: start; font-size: 13px; line-height: 1; color: var(--muted); }
  .node { position: relative; z-index: 1; width: 11px; height: 11px; border-radius: 50%; background: var(--muted); box-shadow: 0 0 0 4px var(--bg); }
  .entry.first .node { background: var(--blue); }

  .card { position: relative; z-index: 1; text-align: left; padding: 26px; }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .badge { font-size: 12px; font-weight: 600; border-radius: 99px; padding: 4px 10px; background: var(--bg); color: var(--ink); }
  .badge.g::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--green); margin-right: 6px; vertical-align: middle; }
  .card h2 { font-size: 24px; letter-spacing: -0.02em; line-height: 1.2; margin: 0 0 10px; }
  .card ul { margin: 0 0 14px; padding-left: 18px; font-size: 15px; }
  .card li + li { margin-top: 5px; }

  /* Video slot: placeholder until the YouTube embed is wired up. */
  .video { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: var(--bg); box-shadow: inset 0 0 0 1px var(--line); margin: 4px 0 22px; }
  .video .ph { position: absolute; inset: 0; display: grid; place-content: center; color: var(--muted); text-align: center; padding: 16px; }
  .video .ph b { font-size: 16px; font-weight: 600; color: var(--ink); }
  .play { width: 44px; height: 44px; border-radius: 50%; background: var(--ink); display: grid; place-items: center; margin: 0 auto 12px; }
  .play::after { content: ""; border-left: 12px solid #fff; border-top: 8px solid transparent; border-bottom: 8px solid transparent; margin-left: 3px; }

  .card details { border-top: 1px solid var(--line); padding-top: 14px; margin-top: 6px; }
  .card summary { cursor: pointer; font-weight: 600; font-size: 15px; list-style: none; display: flex; justify-content: space-between; align-items: center; padding: 11px 0; margin: -11px 0; }
  .card summary::-webkit-details-marker { display: none; }
  .card summary::after { content: "+"; color: var(--muted); font-weight: 400; font-size: 20px; line-height: 1; }
  .card details[open] summary::after { content: "−"; }
  .card details ul { margin: 12px 0 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .actions .btn.v { box-shadow: inset 0 0 0 1px var(--muted); }

  .older { margin: 56px 0 80px; padding: 26px; border-radius: var(--r); background: var(--card); color: var(--muted); font-size: 15px; }
  .older p { margin: 0 0 6px; }
  .older strong { color: var(--ink); }
  .older a { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }

  .card summary:focus-visible, .actions a:focus-visible, .older a:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }

  @media (max-width: 720px) {
    .page { --gutter: 20px; padding-top: 112px; }
    .card { padding: 22px; }
    .older { padding: 22px; }
  }
</style>
