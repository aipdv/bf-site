---
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import { getReleases, formatDay, firstLine, sections, youtubeId } from '../lib/releases';

// Built at deploy time from the GitHub releases, newest first.
const releases = await getReleases();
const download = 'https://github.com/aipdv/better-files/releases/latest';
---
<Base
  title="Changelog: Better Files"
  description="Every Better Files release, newest first, with the notes from GitHub."
>
  <div class="page">
    <header class="top">
      <p class="eyebrow"><i></i>Changelog</p>
      <h1>What’s new in <em class="acc">Better Files.</em></h1>
      <p class="lead">Every release, newest first. Notes come from GitHub.</p>
    </header>

    {releases.length === 0 ? (
      <p class="older">Release notes are not available right now. See <a href="https://github.com/aipdv/better-files/releases">all releases on GitHub</a>.</p>
    ) : (
      <section class="log" aria-label="Releases">
        {releases.map((r, i) => {
          const secs = sections(r.body);
          const bullets = secs.filter((s) => /what/i.test(s.title)).flatMap((s) => s.items);
          const limits = secs.find((s) => /known limits/i.test(s.title))?.items ?? [];
          const video = youtubeId(r.body);
          const apk = r.assets.find((a) => a.name.endsWith('.apk'))?.browser_download_url ?? r.html_url;
          return (
            <article class="entry">
              <div class="meta">
                <span class="ver">{r.tag_name}</span>
                <time datetime={r.published_at}>{formatDay(r.published_at)}</time>
                <div class="badges">
                  {i === 0 && <span class="badge g">Latest</span>}
                  {r.prerelease && <span class="badge">Beta</span>}
                </div>
              </div>
              <div class="card">
                <h2>{firstLine(r.body) || r.tag_name}</h2>

                {video && <YouTube id={video} title={`${r.tag_name} video`} />}

                {bullets.length > 0 && (
                  <ul>
                    {bullets.map((b) => <li>{b}</li>)}
                  </ul>
                )}

                {limits.length > 0 && (
                  <details>
                    <summary>Known limits <span>{limits.length}</span></summary>
                    <ul>
                      {limits.map((l) => <li>{l}</li>)}
                    </ul>
                  </details>
                )}

                <div class="actions">
                  <a class="btn p sm" href={apk}><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224,144v64a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V144a8,8,0,0,1,16,0v56H208V144a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,124.69V32a8,8,0,0,0-16,0v92.69L93.66,98.34a8,8,0,0,0-11.32,11.32Z"/></svg>Download APK</a>
                  <a class="btn v sm" href={r.html_url}><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M208.31,75.68A59.78,59.78,0,0,0,202.93,28,8,8,0,0,0,196,24a59.75,59.75,0,0,0-48,24H124A59.75,59.75,0,0,0,76,24a8,8,0,0,0-6.93,4,59.78,59.78,0,0,0-5.38,47.68A58.14,58.14,0,0,0,56,104v8a56.06,56.06,0,0,0,48.44,55.47A39.8,39.8,0,0,0,96,192v8H72a24,24,0,0,1-24-24A40,40,0,0,0,8,136a8,8,0,0,0,0,16,24,24,0,0,1,24,24,40,40,0,0,0,40,40H96v16a8,8,0,0,0,16,0V192a24,24,0,0,1,48,0v40a8,8,0,0,0,16,0V192a39.8,39.8,0,0,0-8.44-24.53A56.06,56.06,0,0,0,216,112v-8A58.14,58.14,0,0,0,208.31,75.68ZM200,112a40,40,0,0,1-40,40H112a40,40,0,0,1-40-40v-8a41.74,41.74,0,0,1,6.9-22.48A8,8,0,0,0,80,73.83a43.81,43.81,0,0,1,.79-33.58,43.88,43.88,0,0,1,32.32,20.06A8,8,0,0,0,119.82,64h32.35a8,8,0,0,0,6.74-3.69,43.87,43.87,0,0,1,32.32-20.06A43.81,43.81,0,0,1,192,73.83a8.09,8.09,0,0,0,1,7.65A41.72,41.72,0,0,1,200,104Z"/></svg>Release on GitHub</a>
                </div>
              </div>
            </article>
          );
        })}
      </section>
    )}

    <p class="older">Older releases are on <a href="https://github.com/aipdv/better-files/releases">GitHub</a>.</p>
  </div>
</Base>

<style>
  .page { width: min(960px, calc(100% - 40px)); margin: 0 auto; padding-top: 56px; }
  .top { text-align: center; margin-bottom: 80px; }
  .top h1 { font-size: clamp(40px, 6.4vw, 76px); letter-spacing: -0.045em; line-height: 0.98; margin: 0 0 18px; }
  .lead { color: var(--muted); margin: 0 auto; max-width: 520px; font-size: 18px; }

  /* One row per release: version and date on the left, the notes on the right. */
  .entry { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 40px; padding: 40px 0; border-top: 1px solid var(--line); }
  .entry:last-child { border-bottom: 1px solid var(--line); }
  .meta { position: sticky; top: 104px; align-self: start; display: grid; gap: 6px; padding-top: 6px; }
  .ver { font: 600 15px/1.3 var(--mono); color: var(--ink); }
  time { font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .badge { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; border-radius: 99px; padding: 4px 10px; background: var(--card); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
  .badge.g::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--green); }

  .card h2 { font-size: clamp(22px, 2.6vw, 28px); letter-spacing: -0.025em; line-height: 1.15; margin: 0 0 20px; }
  .card > ul { margin-bottom: 8px; }
  .card .video { margin: 0 0 24px; }

  .card details { border-top: 1px solid var(--line); margin-top: 24px; }
  .card summary { cursor: pointer; font-weight: 600; font-size: 15px; list-style: none; display: flex; align-items: center; gap: 8px; padding: 14px 0; }
  .card summary span { font: 500 12px/1 var(--mono); color: var(--muted); background: var(--bg); border-radius: 99px; padding: 4px 8px; }
  .card summary::-webkit-details-marker { display: none; }
  .card summary::after { content: "+"; margin-left: auto; color: var(--muted); font-weight: 400; font-size: 22px; line-height: 1; transition: transform .2s ease; }
  .card details[open] summary::after { transform: rotate(45deg); }
  .card details ul { margin: 4px 0 8px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }

  .older { margin: 40px 0 0; text-align: center; color: var(--muted); font-size: 15px; }
  .older a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }

  @media (max-width: 760px) {
    .top { margin-bottom: 48px; }
    .entry { grid-template-columns: minmax(0, 1fr); gap: 16px; padding: 32px 0; }
    .meta { position: static; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; padding: 0; }
    .badges { margin: 0; }
  }
</style>
