---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';

const download = 'https://github.com/aipdv/better-files/releases/latest';
---
<Base
  title="Better Files: find any file by what's in it"
  description="Better Files is a free, open source Android file manager. Search your documents and photos by meaning. Everything stays on your phone, with no cloud and no account."
>
  <section class="hero wrap">
    <div class="hero-copy">
    <div class="eyebrow" data-reveal="hero"><i></i>Open source for Android</div>
    <h1 data-reveal="hero">Find any file <em class="acc">by what's in it.</em></h1>
    <p class="lead" data-reveal="hero">Type what you remember. Better Files searches your documents and photos by meaning, right on your phone. No cloud. No account.</p>
    <div class="cta" data-reveal="hero">
      <a class="btn p" href={download}><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224,144v64a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V144a8,8,0,0,1,16,0v56H208V144a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,124.69V32a8,8,0,0,0-16,0v92.69L93.66,98.34a8,8,0,0,0-11.32,11.32Z"/></svg>Download APK</a>
      <a class="btn v" href="#video"><b><svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" width="16" height="16"><path d="M232.4,114.49,88.32,26.35a16,16,0,0,0-16.2-.3A15.86,15.86,0,0,0,64,39.87V216.13A15.94,15.94,0,0,0,80,232a16.07,16.07,0,0,0,8.36-2.35L232.4,141.51a15.81,15.81,0,0,0,0-27ZM80,215.94V40l143.83,88Z"/></svg></b>Watch a real search <small>2:15</small></a>
    </div>
    </div>
    <div class="stage" data-stage>
      <div class="chip c1" data-reveal="chip"><b>Search by meaning</b><span>not by file name</span></div>
      <div class="chip c2" data-reveal="chip"><b>Private by default</b><span>search runs on the phone</span></div>
      <div class="chip c3" data-reveal="chip"><b>Documents and photos</b><span>PDF, Word, text, JPG, PNG</span></div>
      <Phone />
    </div>
  </section>

  <div class="wrap">
    <p class="statement" data-reveal="words">You remember what a file was about. <span>The name is long gone.</span></p>

    <div class="steps">
      <div data-reveal="up"><em>i.</em><p><b>Accept the model once.</b><span>It downloads about 320 MB. Photo search adds 110 MB more.</span></p></div>
      <div data-reveal="up"><em>ii.</em><p><b>It indexes your files on the phone.</b><span>Newest files go first. On older phones, the first pass can take hours.</span></p></div>
      <div data-reveal="up"><em>iii.</em><p><b>Search the way you'd describe it.</b><span>Try "land records" or "beach at sunset". English, Hindi and Hinglish all work.</span></p></div>
    </div>

    <section class="sec" id="features">
      <div class="head">
        <p class="kicker">Features</p>
        <h2>A file manager that reads your files</h2>
        <p class="sub">The usual file manager tools, plus a search that reads what's inside each file.</p>
      </div>
      <div class="cards">
        <div class="card" data-reveal="up"><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"/></svg><h3>Search by meaning</h3><p>Type "rent agreement" or "beach at sunset". It finds the file even if you named it something else.</p></div>
        <div class="card" data-reveal="up"><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M176,16H80A24,24,0,0,0,56,40V216a24,24,0,0,0,24,24h96a24,24,0,0,0,24-24V40A24,24,0,0,0,176,16ZM72,64H184V192H72Zm8-32h96a8,8,0,0,1,8,8v8H72V40A8,8,0,0,1,80,32Zm96,192H80a8,8,0,0,1-8-8v-8H184v8A8,8,0,0,1,176,224Z"/></svg><h3>Runs on your phone</h3><p>The search model and index live on the device. Your files, their names and your searches stay there.</p></div>
        <div class="card" data-reveal="up"><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M245,110.64A16,16,0,0,0,232,104H216V88a16,16,0,0,0-16-16H130.67L102.94,51.2a16.14,16.14,0,0,0-9.6-3.2H40A16,16,0,0,0,24,64V208h0a8,8,0,0,0,8,8H211.1a8,8,0,0,0,7.59-5.47l28.49-85.47A16.05,16.05,0,0,0,245,110.64ZM93.34,64,123.2,86.4A8,8,0,0,0,128,88h72v16H69.77a16,16,0,0,0-15.18,10.94L40,158.7V64Zm112,136H43.1l26.67-80H232Z"/></svg><h3>The rest of the toolbox</h3><p>Archives, root access, SMB, SFTP, FTP, WebDAV and themes. Built on Material Files.</p></div>
      </div>
    </section>

    <section class="sec vid" id="video">
      <div class="head">
        <p class="kicker">Demo</p>
        <h2>See it work</h2>
        <p class="sub">A real search, recorded on a six-year-old phone.</p>
      </div>
      <div class="video">
        <video muted loop playsinline preload="none" poster="/video-poster.jpg">
          <source src="/better-files-launch.mp4" type="video/mp4" />
        </video>
        <div class="vctl">
          <button class="vbtn pp" type="button" aria-label="Pause" hidden>
            <svg class="i-pause" width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M200,32H160a16,16,0,0,0-16,16V208a16,16,0,0,0,16,16h40a16,16,0,0,0,16-16V48A16,16,0,0,0,200,32Zm0,176H160V48h40ZM96,32H56A16,16,0,0,0,40,48V208a16,16,0,0,0,16,16H96a16,16,0,0,0,16-16V48A16,16,0,0,0,96,32Zm0,176H56V48H96Z"/></svg>
            <svg class="i-play" width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M232.4,114.49,88.32,26.35a16,16,0,0,0-16.2-.3A15.86,15.86,0,0,0,64,39.87V216.13A15.94,15.94,0,0,0,80,232a16.07,16.07,0,0,0,8.36-2.35L232.4,141.51a15.81,15.81,0,0,0,0-27ZM80,215.94V40l143.83,88Z"/></svg>
          </button>
          <button class="vbtn fs" type="button" aria-label="Full screen">
            <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M216,48V96a8,8,0,0,1-16,0V67.31l-42.34,42.35a8,8,0,0,1-11.32-11.32L188.69,56H160a8,8,0,0,1,0-16h48A8,8,0,0,1,216,48ZM98.34,146.34,56,188.69V160a8,8,0,0,0-16,0v48a8,8,0,0,0,8,8H96a8,8,0,0,0,0-16H67.31l42.35-42.34a8,8,0,0,0-11.32-11.32ZM208,152a8,8,0,0,0-8,8v28.69l-42.34-42.35a8,8,0,0,0-11.32,11.32L188.69,200H160a8,8,0,0,0,0,16h48a8,8,0,0,0,8-8V160A8,8,0,0,0,208,152ZM67.31,56H96a8,8,0,0,0,0-16H48a8,8,0,0,0-8,8V96a8,8,0,0,0,16,0V67.31l42.34,42.35a8,8,0,0,0,11.32-11.32Z"/></svg>
          </button>
          <button class="sound" type="button">Tap for sound</button>
        </div>
      </div>
    </section>

    <section class="sec" id="privacy">
      <div class="head">
        <p class="kicker">Privacy</p>
        <h2>What stays private</h2>
        <p class="sub">There is no account, and no server of ours receives your files.</p>
      </div>
      <div class="cards">
        <div class="card" data-reveal="up"><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M208,80H176V56a48,48,0,0,0-96,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80ZM96,56a32,32,0,0,1,64,0V80H96ZM208,208H48V96H208V208Zm-68-56a12,12,0,1,1-12-12A12,12,0,0,1,140,152Z"/></svg><h3>Nothing leaves</h3><p>Your files, file names, folders and searches stay on your phone.</p></div>
        <div class="card" data-reveal="up"><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M176,56H80a72,72,0,0,0,0,144h96a72,72,0,0,0,0-144Zm0,128H80A56,56,0,0,1,80,72h96a56,56,0,0,1,0,112ZM80,88a40,40,0,1,0,40,40A40,40,0,0,0,80,88Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,80,152Z"/></svg><h3>Analytics start off</h3><p>You can turn them on in Settings. If you do, only anonymous usage counts go to PostHog in the EU.</p></div>
        <div class="card" data-reveal="up"><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M53.92,34.62A8,8,0,1,0,42.08,45.38L61.32,66.55C25,88.84,9.38,123.2,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208a127.11,127.11,0,0,0,52.07-10.83l22,24.21a8,8,0,1,0,11.84-10.76Zm47.33,75.84,41.67,45.85a32,32,0,0,1-41.67-45.85ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.16,133.16,0,0,1,25,128c4.69-8.79,19.66-33.39,47.35-49.38l18,19.75a48,48,0,0,0,63.66,70l14.73,16.2A112,112,0,0,1,128,192Zm6-95.43a8,8,0,0,1,3-15.72,48.16,48.16,0,0,1,38.77,42.64,8,8,0,0,1-7.22,8.71,6.39,6.39,0,0,1-.75,0,8,8,0,0,1-8-7.26A32.09,32.09,0,0,0,134,96.57Zm113.28,34.69c-.42.94-10.55,23.37-33.36,43.8a8,8,0,1,1-10.67-11.92A132.77,132.77,0,0,0,231.05,128a133.15,133.15,0,0,0-23.12-30.77C185.67,75.19,158.78,64,128,64a118.37,118.37,0,0,0-19.36,1.57A8,8,0,1,1,106,49.79,134,134,0,0,1,128,48c34.88,0,66.57,13.26,91.66,38.35,18.83,18.83,27.3,37.62,27.65,38.41A8,8,0,0,1,247.31,131.26Z"/></svg><h3>No ads, no tracking</h3><p>No advertising ID and no Google Play Services. The full details are in the <a href="/privacy/">privacy policy</a>.</p></div>
      </div>
    </section>

    <section class="sec" id="limits">
      <div class="head">
        <p class="kicker">Beta</p>
        <h2>Before you install</h2>
        <p class="sub">It's a beta. These are the limits we know about.</p>
      </div>
      <div class="two">
        <div class="card" data-reveal="up">
          <svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"/></svg>
          <h3>Requirements</h3>
          <ul>
            <li>Android 10 or newer.</li>
            <li>The search model downloads once, about 320 MB. Photo search adds 110 MB.</li>
            <li>Meaning and photo search need about 3.5 GB of RAM. On phones with less, search matches keywords inside documents.</li>
          </ul>
        </div>
        <div class="card" data-reveal="up">
          <svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM222.93,203.8a8.5,8.5,0,0,1-7.48,4.2H40.55a8.5,8.5,0,0,1-7.48-4.2,7.59,7.59,0,0,1,0-7.72L120.52,44.21a8.75,8.75,0,0,1,15,0l87.45,151.87A7.59,7.59,0,0,1,222.93,203.8ZM120,144V104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,180Z"/></svg>
          <h3>Known limits</h3>
          <ul>
            <li>The first index can take hours on older phones. Each file is searchable as soon as it's done.</li>
            <li>Some phones stop apps in the background. If indexing stops, open Better Files and it picks up where it left off.</li>
            <li>Scanned PDFs and password-protected PDFs can't be searched yet.</li>
            <li>Excel, PowerPoint and old .doc files aren't indexed yet.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="end">
      <h2>Install it and search by <em class="acc">what you remember.</em></h2>
      <div class="cta">
        <a class="btn p" href={download}><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224,144v64a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V144a8,8,0,0,1,16,0v56H208V144a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,124.69V32a8,8,0,0,0-16,0v92.69L93.66,98.34a8,8,0,0,0-11.32,11.32Z"/></svg>Download APK</a>
        <a class="btn v" href="https://github.com/aipdv/better-files"><svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M208.31,75.68A59.78,59.78,0,0,0,202.93,28,8,8,0,0,0,196,24a59.75,59.75,0,0,0-48,24H124A59.75,59.75,0,0,0,76,24a8,8,0,0,0-6.93,4,59.78,59.78,0,0,0-5.38,47.68A58.14,58.14,0,0,0,56,104v8a56.06,56.06,0,0,0,48.44,55.47A39.8,39.8,0,0,0,96,192v8H72a24,24,0,0,1-24-24A40,40,0,0,0,8,136a8,8,0,0,0,0,16,24,24,0,0,1,24,24,40,40,0,0,0,40,40H96v16a8,8,0,0,0,16,0V192a24,24,0,0,1,48,0v40a8,8,0,0,0,16,0V192a39.8,39.8,0,0,0-8.44-24.53A56.06,56.06,0,0,0,216,112v-8A58.14,58.14,0,0,0,208.31,75.68ZM200,112a40,40,0,0,1-40,40H112a40,40,0,0,1-40-40v-8a41.74,41.74,0,0,1,6.9-22.48A8,8,0,0,0,80,73.83a43.81,43.81,0,0,1,.79-33.58,43.88,43.88,0,0,1,32.32,20.06A8,8,0,0,0,119.82,64h32.35a8,8,0,0,0,6.74-3.69,43.87,43.87,0,0,1,32.32-20.06A43.81,43.81,0,0,1,192,73.83a8.09,8.09,0,0,0,1,7.65A41.72,41.72,0,0,1,200,104Z"/></svg>Source on GitHub</a>
      </div>
    </section>
  </div>
</Base>

<script>
  import '../scripts/motion.ts';
</script>
