---
// A code-built replica of a Better Files search. No images.
// It copies the real result list: thumbnail, file name, date and size.
// Loop: 14 s. "land records" with documents, then "beach at sunset" with photos.
// Slow fades only. Under prefers-reduced-motion nothing moves (seizure safety).
const docs = [
  ['Property-papers-2023.pdf', 'Aug 24, 2023', '1.2 MB', true],
  ['Mutation-certificate.pdf', 'Jul 24', '228 kB', true],
  ['Land-revenue-2022.pdf', 'Jul 24', '168 kB', true],
  ['Tax-receipt-Q3.docx', 'Apr 23, 2023', '96 kB', false],
  ['Plot-map-final.pdf', 'May 26, 2024', '3.77 MB', true],
  ['Sale-agreement-draft.docx', 'Jan 9', '54 kB', false],
  ['Survey-notes.txt', 'Dec 2, 2023', '4 kB', false],
];
const photos = [
  ['IMG_20240612_184512.jpg', 'Jun 12, 2024', '3.1 MB', '#F7B267 0 45%,#F4845F 45% 60%,#2D6A8F 60%'],
  ['IMG_20240612_185130.jpg', 'Jun 12, 2024', '2.8 MB', '#FFD6A5 0 50%,#E76F51 50% 58%,#264653 58%'],
  ['IMG-20231228-WA0014.jpg', 'Dec 28, 2023', '412 kB', '#F9C74F 0 40%,#F3722C 40% 55%,#277DA1 55%'],
  ['PXL_20230503_174402.jpg', 'May 3, 2023', '4.6 MB', '#FEC89A 0 55%,#F28482 55% 62%,#3D5A80 62%'],
  ['IMG-20230417-WA0007.jpg', 'Apr 17, 2023', '71 kB', '#FFB4A2 0 48%,#E5989B 48% 56%,#1D3557 56%'],
  ['Screenshot_goa_trip.png', 'Feb 11, 2023', '1.4 MB', '#FAD2A0 0 42%,#E07A5F 42% 52%,#3D405B 52%'],
  ['IMG_20221120_172930.jpg', 'Nov 20, 2022', '3.3 MB', '#FFCB77 0 46%,#FE6D73 46% 57%,#227C9D 57%'],
];
const d = (i: number) => (i ? `d${i}` : '');
---
<div class="rp" role="img" aria-label="Better Files finds documents for the search land records, then photos for the search beach at sunset">
  <div class="s" aria-hidden="true">
    <div class="sb"><span>9:41</span><span>85%</span></div>
    <div class="bar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E8EAED" stroke-width="2.2"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
      <div class="q"><span class="qa">land records</span><span class="qb">beach at sunset</span></div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E8EAED" stroke-width="2.2"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </div>
    <div class="lbl">Internal storage</div>
    <div class="scene A">
      {docs.map(([n, dt, sz, pdf], i) => (
        <div class={`row ${d(i)}`}><div class:list={['th', { pdf }]}></div><div class="t"><div class="n">{n}</div><div class="m">{dt}<i>{sz}</i></div></div><b class="k">⋮</b></div>
      ))}
    </div>
    <div class="scene B">
      {photos.map(([n, dt, sz, g], i) => (
        <div class={`row ${d(i)}`}><div class="th ph" style={`background:linear-gradient(${g})`}></div><div class="t"><div class="n">{n}</div><div class="m">{dt}<i>{sz}</i></div></div><b class="k">⋮</b></div>
      ))}
    </div>
    <div class="nb"><span>☰</span><span>◯</span><span>◁</span></div>
  </div>
</div>

<style>
  .rp { width: 320px; max-width: 84vw; margin: 0 auto; border-radius: 50px; padding: 10px; background: #0B0B0C; box-shadow: 0 30px 80px rgba(0, 0, 0, .25); position: relative; }
  .s { border-radius: 41px; background: #121316; height: 640px; overflow: hidden; color: #E8EAED; text-align: left; position: relative; font-family: Roboto, -apple-system, sans-serif; }
  .sb { display: flex; justify-content: space-between; padding: 14px 26px 0; font-size: 13px; color: #C4C7C5; }
  .bar { margin: 16px 12px 4px; height: 52px; display: flex; align-items: center; padding: 0 12px; gap: 16px; font-size: 18px; }
  .bar svg { flex: none; }
  .q { position: relative; height: 24px; flex: 1; }
  .q span { position: absolute; left: 0; top: 0; white-space: nowrap; line-height: 24px; clip-path: inset(0 100% 0 0); }
  .lbl { font-size: 13px; font-weight: 500; color: #C4C7C5; padding: 10px 0 6px 68px; }
  .scene { position: absolute; left: 0; right: 0; top: 146px; }
  .row { display: grid; grid-template-columns: 40px minmax(0, 1fr) 16px; gap: 14px; align-items: center; padding: 9px 14px 9px 16px; opacity: 0; }
  .th { width: 40px; height: 48px; border-radius: 4px; background: #F1F3F4; position: relative; overflow: hidden; }
  .th::before { content: ""; position: absolute; left: 6px; right: 6px; top: 8px; height: 30px; background: repeating-linear-gradient(#C9CDD2 0 2px, transparent 2px 6px); }
  .th.pdf::after { content: "PDF"; position: absolute; bottom: 2px; right: 3px; font-size: 7px; font-weight: 700; color: #D93025; }
  .th.ph { height: 40px; border-radius: 6px; }
  .th.ph::before { display: none; }
  .t { min-width: 0; }
  .n { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .m { font-size: 12.5px; color: #9AA0A6; margin-top: 2px; }
  .m i { font-style: normal; margin-left: 12px; }
  .k { color: #C4C7C5; font-weight: 400; font-size: 18px; text-align: center; }
  .nb { position: absolute; bottom: 0; left: 0; right: 0; height: 40px; display: flex; justify-content: space-around; align-items: center; color: #9AA0A6; font-size: 16px; background: #121316; }

  /* 14 s loop. 0-50%: documents. 50-100%: photos. */
  .A { animation: sA 14s infinite; }
  .B { animation: sB 14s infinite; }
  @keyframes sA { 0%, 46% { opacity: 1 } 50%, 96% { opacity: 0 } 100% { opacity: 1 } }
  @keyframes sB { 0%, 46% { opacity: 0 } 50%, 96% { opacity: 1 } 100% { opacity: 0 } }
  .qa { animation: tA 14s infinite; }
  .qb { animation: tB 14s infinite; }
  @keyframes tA {
    0% { clip-path: inset(0 100% 0 0); animation-timing-function: steps(12, end); }
    12%, 46% { clip-path: inset(0 0 0 0); }
    47%, 100% { clip-path: inset(0 100% 0 0); }
  }
  @keyframes tB {
    0%, 50% { clip-path: inset(0 100% 0 0); animation-timing-function: steps(15, end); }
    63%, 96% { clip-path: inset(0 0 0 0); }
    97%, 100% { clip-path: inset(0 100% 0 0); }
  }
  .A .row { animation: rA 14s infinite; }
  .B .row { animation: rB 14s infinite; }
  @keyframes rA { 0%, 14% { opacity: 0; transform: translateY(6px) } 19%, 44% { opacity: 1; transform: none } 47%, 100% { opacity: 0 } }
  @keyframes rB { 0%, 64% { opacity: 0; transform: translateY(6px) } 69%, 94% { opacity: 1; transform: none } 97%, 100% { opacity: 0 } }
  .d1 { animation-delay: .2s !important; }
  .d2 { animation-delay: .4s !important; }
  .d3 { animation-delay: .6s !important; }
  .d4 { animation-delay: .8s !important; }
  .d5 { animation-delay: 1s !important; }
  .d6 { animation-delay: 1.2s !important; }

  @media (prefers-reduced-motion: reduce) {
    .rp * { animation: none !important; }
    .B { display: none; }
    .A .row { opacity: 1; }
    .q .qa { clip-path: none; }
    .q .qb { display: none; }
  }
</style>
