---
// A code-built replica of a Better Files search.
// It copies the real result list: thumbnail, file name, date and size.
// Loop: 5 searches x 7 s = 35 s. Docs, then photos. Photos: Unsplash (free license), 120 px WebP.
// Slow fades only. Under prefers-reduced-motion nothing moves (seizure safety).
// The screen cannot be selected, copied or right-clicked: it is a picture of the app, not page text.
const img = import.meta.glob<{ default: ImageMetadata }>('../assets/phone/*.webp', { eager: true });
const ph = (set: string, i: number) => img[`../assets/phone/${set}-${i}.webp`].default.src;
type Row = [name: string, date: string, size: string, thumb: string];
const photos = (set: string, rows: string[][]): Row[] => rows.map(([n, dt, sz], i) => [n, dt, sz, ph(set, i + 1)]);

const scenes: { q: string; rows: Row[] }[] = [
  { q: 'land records', rows: [
    ['Property-papers-2023.pdf', 'Aug 24, 2023', '1.2 MB', 'pdf'],
    ['Mutation-certificate.pdf', 'Jul 24', '228 kB', 'pdf'],
    ['Land-revenue-2022.pdf', 'Jul 24', '168 kB', 'pdf'],
    ['Tax-receipt-Q3.docx', 'Apr 23, 2023', '96 kB', 'doc'],
    ['Plot-map-final.pdf', 'May 26, 2024', '3.77 MB', 'pdf'],
    ['Sale-agreement-draft.docx', 'Jan 9', '54 kB', 'doc'],
    ['Survey-notes.txt', 'Dec 2, 2023', '4 kB', 'doc'],
  ] },
  { q: 'beach at sunset', rows: photos('beach', [
    ['IMG_20240612_184512.jpg', 'Jun 12, 2024', '3.1 MB'],
    ['IMG_20240612_185130.jpg', 'Jun 12, 2024', '2.8 MB'],
    ['IMG-20231228-WA0014.jpg', 'Dec 28, 2023', '412 kB'],
    ['PXL_20230503_174402.jpg', 'May 3, 2023', '4.6 MB'],
    ['IMG-20230417-WA0007.jpg', 'Apr 17, 2023', '71 kB'],
    ['Screenshot_goa_trip.png', 'Feb 11, 2023', '1.4 MB'],
    ['IMG_20221120_172930.jpg', 'Nov 20, 2022', '3.3 MB'],
  ]) },
  { q: 'animals at the zoo', rows: photos('zoo', [
    ['IMG_20240302_113015.jpg', 'Mar 2, 2024', '3.4 MB'],
    ['IMG_20240302_114802.jpg', 'Mar 2, 2024', '2.9 MB'],
    ['IMG-20231105-WA0021.jpg', 'Nov 5, 2023', '188 kB'],
    ['PXL_20230819_101233.jpg', 'Aug 19, 2023', '5.0 MB'],
    ['IMG_20230819_102940.jpg', 'Aug 19, 2023', '3.7 MB'],
    ['IMG-20230114-WA0003.jpg', 'Jan 14, 2023', '96 kB'],
    ['IMG_20221009_154410.jpg', 'Oct 9, 2022', '2.6 MB'],
  ]) },
  { q: 'birthday cake', rows: photos('cake', [
    ['IMG_20240915_201144.jpg', 'Sep 15, 2024', '2.7 MB'],
    ['IMG-20240501-WA0032.jpg', 'May 1, 2024', '144 kB'],
    ['PXL_20231222_212005.jpg', 'Dec 22, 2023', '4.1 MB'],
    ['IMG_20231222_212310.jpg', 'Dec 22, 2023', '3.0 MB'],
    ['IMG-20230710-WA0011.jpg', 'Jul 10, 2023', '201 kB'],
    ['IMG_20230305_190722.jpg', 'Mar 5, 2023', '2.2 MB'],
    ['Screenshot_bakery_order.png', 'Jan 3, 2023', '860 kB'],
  ]) },
  { q: 'snow mountains', rows: photos('snow', [
    ['IMG_20240124_090512.jpg', 'Jan 24, 2024', '4.4 MB'],
    ['PXL_20240124_093018.jpg', 'Jan 24, 2024', '5.2 MB'],
    ['IMG-20231230-WA0008.jpg', 'Dec 30, 2023', '233 kB'],
    ['IMG_20230611_071140.jpg', 'Jun 11, 2023', '3.8 MB'],
    ['IMG_20230611_072455.jpg', 'Jun 11, 2023', '3.5 MB'],
    ['IMG-20221218-WA0019.jpg', 'Dec 18, 2022', '118 kB'],
    ['Screenshot_manali_trip.png', 'Nov 2, 2022', '1.2 MB'],
  ]) },
];
// Timing in seconds inside each 7 s scene. Keep in sync with the 35s keyframes below.
const SCENE = 7, TYPE = 0.3, KEY = 0.09, ROWS = 2.2, ROW = 0.12;
const at = (s: number) => `animation-delay:${s.toFixed(2)}s`;
---
<div class="rp" role="img" aria-label={`Better Files finds files for the searches ${scenes.map((s) => s.q).join(', ')}`} oncontextmenu="return false" ondragstart="return false">
  <div class="s" aria-hidden="true">
    <div class="sb">
      <span>9:41</span>
      <span class="air"><svg width="14" height="14" viewBox="0 0 24 24" fill="#C4C7C5"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z" /></svg>85%</span>
    </div>
    <div class="bar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E8EAED" stroke-width="2.2"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
      <div class="q">
        {scenes.map(({ q }, i) => (
          <span class="w" style={at(i * SCENE)}>{[...q].map((c, k) => <i style={at(i * SCENE + TYPE + k * KEY)}>{c === ' ' ? ' ' : c}</i>)}</span>
        ))}
      </div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E8EAED" stroke-width="2.2"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </div>
    <div class="lbl">Internal storage</div>
    {scenes.map(({ rows }, i) => (
      <div class="scene w" style={at(i * SCENE)}>
        {rows.map(([n, dt, sz, th], j) => (
          <div class="row" style={at(i * SCENE + ROWS + j * ROW)}>
            {th === 'pdf' || th === 'doc'
              ? <div class:list={['th', { pdf: th === 'pdf' }]}></div>
              : <div class="th ph" style={`background-image:url(${th})`}></div>}
            <div class="t"><div class="n">{n}</div><div class="m">{dt}<i>{sz}</i></div></div><b class="k">⋮</b>
          </div>
        ))}
      </div>
    ))}
    <div class="nb"><span>☰</span><span>◯</span><span>◁</span></div>
  </div>
</div>

<style>
  .rp { width: 320px; max-width: 84vw; margin: 0 auto; border-radius: 50px; padding: 10px; background: #0B0B0C; box-shadow: 0 30px 80px rgba(0, 0, 0, .25); position: relative; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
  .s { border-radius: 41px; background: #121316; height: 640px; overflow: hidden; color: #E8EAED; text-align: left; position: relative; font-family: Roboto, -apple-system, sans-serif; }
  .sb { display: flex; justify-content: space-between; padding: 14px 26px 0; font-size: 13px; color: #C4C7C5; }
  .air { display: flex; align-items: center; gap: 6px; }
  .bar { margin: 16px 12px 4px; height: 52px; display: flex; align-items: center; padding: 0 12px; gap: 16px; font-size: 18px; }
  .bar svg { flex: none; }
  .q { position: relative; height: 24px; flex: 1; }
  .q .w { position: absolute; left: 0; top: 0; white-space: nowrap; line-height: 24px; }
  .q i { font-style: normal; opacity: 0; animation: on 35s infinite; }
  .lbl { font-size: 13px; font-weight: 500; color: #C4C7C5; padding: 10px 0 6px 68px; }
  .scene { position: absolute; left: 0; right: 0; top: 146px; }
  .row { display: grid; grid-template-columns: 40px minmax(0, 1fr) 16px; gap: 14px; align-items: center; padding: 9px 14px 9px 16px; opacity: 0; animation: rise 35s infinite; }
  .th { width: 40px; height: 48px; border-radius: 4px; background: #F1F3F4; position: relative; overflow: hidden; }
  .th::before { content: ""; position: absolute; left: 6px; right: 6px; top: 8px; height: 30px; background: repeating-linear-gradient(#C9CDD2 0 2px, transparent 2px 6px); }
  .th.pdf::after { content: "PDF"; position: absolute; bottom: 2px; right: 3px; font-size: 7px; font-weight: 700; color: #D93025; }
  .th.ph { height: 40px; border-radius: 6px; background: #2A2B2E center / cover; }
  .th.ph::before { display: none; }
  .t { min-width: 0; }
  .n { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .m { font-size: 12.5px; color: #9AA0A6; margin-top: 2px; }
  .m i { font-style: normal; margin-left: 12px; }
  .k { color: #C4C7C5; font-weight: 400; font-size: 18px; text-align: center; }
  .nb { position: absolute; bottom: 0; left: 0; right: 0; height: 40px; display: flex; justify-content: space-around; align-items: center; color: #9AA0A6; font-size: 16px; background: #121316; }

  /* 35 s loop, 7 s per scene (1 s = 2.857%). Each element gets its start time as animation-delay.
     .w: a scene's query and results, shown 0-6.4 s, faded out by 6.8 s.
     on / rise: a letter or a row appears at its delay and stays; its scene's .w hides it. */
  .w { opacity: 0; animation: win 35s infinite; }
  @keyframes win { 0%, 18.3% { opacity: 1 } 19.4%, 100% { opacity: 0 } }
  @keyframes on { 0%, 50% { opacity: 1 } 50.1%, 100% { opacity: 0 } }
  @keyframes rise { 0% { opacity: 0; transform: translateY(6px) } 1.4%, 50% { opacity: 1; transform: none } 50.1%, 100% { opacity: 0 } }

  @media (prefers-reduced-motion: reduce) {
    .rp * { animation: none !important; }
    .q .w:first-child, .q .w:first-child i, .lbl + .scene, .lbl + .scene .row { opacity: 1; }
  }
</style>
